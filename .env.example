SERVER_JWT_SECRET=change-me-to-a-random-64-char-hex-string
ADMIN_SECRET=change-me-admin-bootstrap-password
DATABASE_URL=sqlite:///./credential.db

# 對外網域，Caddy 用來自動申請 Let's Encrypt 憑證（不要寫 IP，也不要 commit 真實值進 .env.example）
# SITE_DOMAIN=your-domain.example.com

# IP 白名單（逗號分隔），留空表示不限制
# ALLOWED_IPS=1.2.3.4,5.6.7.8
# 允許註冊的 Email 網域（逗號分隔），留空表示不限制
# ALLOWED_EMAIL_DOMAINS=company.com,company.tw
